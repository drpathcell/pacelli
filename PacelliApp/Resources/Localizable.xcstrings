    "Signed in, but we couldn't load your home. Please try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión iniciada, pero no pudimos cargar tu hogar. Inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso effettuato, ma non siamo riusciti a caricare la tua casa. Riprova."
          }
        }
      }
    },
    "Something went wrong": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è andato storto"
          }
        }
      }
    },
    "Sort order and record identifiers": {
      "localizations": {
        "es": {
