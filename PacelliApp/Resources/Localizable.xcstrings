    "Ask someone already in the household to open Household → Join code. You don't need an account — you can add one later.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a alguien que ya esté en el hogar que abra Hogar → Código de acceso. No necesitas una cuenta — puedes crearla más tarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi a chi è già nella casa di aprire Casa → Codice di accesso. Non serve un account — puoi crearlo più tardi."
          }
        }
      }
    },
