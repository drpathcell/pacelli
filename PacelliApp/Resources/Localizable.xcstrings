    "Account deletion was cancelled. Your data has already been wiped; sign-in state is unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se canceló la eliminación de la cuenta. Tus datos ya se han borrado; la sesión no ha cambiado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'eliminazione dell'account è stata annullata. I tuoi dati sono già stati cancellati; l'accesso resta invariato."
