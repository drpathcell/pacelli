            "state": "translated",
            "value": "Ordinamento e identificatori dei record"
          }
        }
      }
    },
    "Subtask": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtarea"
          }
        },
        "it": {
