            "value": "Titoli delle sottoattività"
          }
        }
      }
    },
    "Subtasks": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtareas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sottoattività"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema"
          }
        }
      }
    },
    "Task": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarea"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attività"
          }
        }
      }
    },
    "Task titles and notes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos y notas de tareas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Titoli e note delle attività"
          }
        }
      }
    },
    "Tasks": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tareas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attività"
          }
        }
      }
    },
    "Tasks, checklists, plans and the manual — everything is searched after decryption, on this device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tareas, listas, planes y el manual — todo se busca tras descifrarse, en este dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attività, liste, piani e il manuale — tutto viene cercato dopo la decifratura, su questo dispositivo."
          }
        }
      }
    },
    "Tell us more…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos más…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicci di più…"
          }
        }
      }
    },
    "Thank you!": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie!"
          }
        }
      }
    },
    "That code didn't unlock the household. Ask for a freshly generated one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código no desbloqueó el hogar. Pide uno recién generado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel codice non ha sbloccato la casa. Chiedine uno appena generato."
          }
        }
      }
    },
    "That code expired — create a new one": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código caducó — crea uno nuevo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel codice è scaduto — creane uno nuovo"
          }
        }
      }
    },
    "That code isn't valid any more. Ask for a new one — codes expire after 7 days.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código ya no es válido. Pide uno nuevo — los códigos caducan a los 7 días."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel codice non è più valido. Chiedine uno nuovo — i codici scadono dopo 7 giorni."
          }
        }
      }
    },
    "That took too long. Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tardó demasiado. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci è voluto troppo tempo. Controlla la connessione e riprova."
          }
        }
      }
    },
    "The exported file contains your household data in readable form — it is not encrypted. Keep it somewhere safe.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo exportado contiene los datos de tu hogar en forma legible — no está cifrado. Guárdalo en un lugar seguro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file esportato contiene i dati della tua casa in forma leggibile — non è cifrato. Conservalo in un luogo sicuro."
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema"
          }
        }
      }
    },
    "There's an invite waiting for you, but we couldn't join that household. Ask whoever invited you for a join code instead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una invitación esperándote, pero no pudimos unirte a ese hogar. Pide a quien te invitó un código de acceso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è un invito che ti aspetta, ma non siamo riusciti a unirti a quella casa. Chiedi a chi ti ha invitato un codice di accesso."
          }
        }
      }
    },
    "These fields stay readable so the app can query, sort and enforce access rules on the server. They contain no free-text content.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos campos permanecen legibles para que la app pueda consultar, ordenar y aplicar reglas de acceso en el servidor. No contienen texto libre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi campi restano leggibili così l'app può interrogare, ordinare e applicare le regole di accesso sul server. Non contengono testo libero."
          }
        }
      }
    },
    "They join when they sign in to Pacelli with this email. The household key is shared securely as part of the invite.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se unirán al iniciar sesión en Pacelli con este correo. La clave del hogar se comparte de forma segura como parte de la invitación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si uniranno accedendo a Pacelli con questa email. La chiave della casa viene condivisa in modo sicuro come parte dell'invito."
          }
        }
      }
    },
    "This also deletes its items. This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se eliminan sus elementos. No se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno eliminati anche i suoi elementi. Non si può annullare."
          }
        }
      }
    },
    "This also deletes its subtasks. This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se eliminan sus subtareas. No se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno eliminate anche le sue sottoattività. Non si può annullare."
          }
        }
      }
    },
    "This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può annullare."
          }
        }
      }
    },
    "This cannot be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione non si può annullare."
          }
        }
      }
    },
    "This permanently deletes your tasks, checklists, plans, categories, household and account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente tus tareas, listas, planes, categorías, hogar y cuenta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina definitivamente attività, liste, piani, categorie, casa e account."
          }
        }
      }
    },
    "Title": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Título"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Titolo"
          }
        }
      }
    },
    "Turn off the code": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar el código"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva il codice"
          }
        }
      }
    },
    "Type": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo"
          }
        }
      }
    },
    "Urgent": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Urgente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Urgente"
          }
        }
      }
    },
    "Using Pacelli as a guest": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usando Pacelli como invitado"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai usando Pacelli come ospite"
          }
        }
      }
    },
    "We couldn't restore your previous session, so we've reset it. Continue as guest below.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos restaurar tu sesión anterior, así que la hemos restablecido. Continúa como invitado abajo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti a ripristinare la sessione precedente, quindi l'abbiamo azzerata. Continua come ospite qui sotto."
          }
        }
      }
    },
    "Write it down…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escríbelo…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivilo…"
          }
        }
      }
    },
    "You": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu"
          }
        }
      }
    },
    "You joined, but we couldn't open the household. Try reopening Pacelli.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te uniste, pero no pudimos abrir el hogar. Prueba a reabrir Pacelli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti sei unito, ma non siamo riusciti ad aprire la casa. Prova a riaprire Pacelli."
          }
        }
      }
    },
    "You're already a member of that household.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya eres miembro de ese hogar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai già parte di quella casa."
          }
        }
      }
    },
    "You're not signed in.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No has iniciado sesión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai effettuato l'accesso."
          }
        }
      }
    },
    "You've been invited to a household, but we couldn't join it. Ask whoever invited you for a join code and use “I have a join code” below.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te han invitado a un hogar, pero no pudimos unirte. Pide a quien te invitó un código de acceso y usa «Tengo un código de acceso» abajo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei stato invitato in una casa, ma non siamo riusciti a unirti. Chiedi a chi ti ha invitato un codice di accesso e usa «Ho un codice di accesso» qui sotto."
          }
        }
      }
    },
    "Your content is encrypted on this device with AES-256 before it is uploaded. Each household has its own random key; that key is wrapped with a key derived from your account and stored so only household members can unwrap it. Your keys are cached in the device Keychain and never leave your devices unencrypted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu contenido se cifra en este dispositivo con AES-256 antes de subirse. Cada hogar tiene su propia clave aleatoria; esa clave se envuelve con una clave derivada de tu cuenta y se guarda de modo que solo los miembros del hogar puedan abrirla. Tus claves se guardan en el llavero del dispositivo y nunca salen de tus dispositivos sin cifrar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi contenuti vengono cifrati su questo dispositivo con AES-256 prima del caricamento. Ogni casa ha la propria chiave casuale; quella chiave è avvolta con una chiave derivata dal tuo account e salvata in modo che solo i membri della casa possano aprirla. Le tue chiavi restano nel portachiavi del dispositivo e non lasciano mai i tuoi dispositivi in chiaro."
          }
        }
      }
    },
    "Your data": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati"
          }
        }
      }
    },
    "Your data lives safely in this household. Create an account to keep it if you switch devices.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos viven seguros en este hogar. Crea una cuenta para conservarlos si cambias de dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati sono al sicuro in questa casa. Crea un account per conservarli se cambi dispositivo."
          }
        }
      }
    },
    "Your display name": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre visible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome visualizzato"
          }
        }
      }
    },
    "Your feedback has been sent.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu opinión se ha enviado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo feedback è stato inviato."
          }
        }
      }
    },
    "Your household and tasks come with you — nothing is lost.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu hogar y tus tareas van contigo — no se pierde nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua casa e le tue attività vengono con te — non si perde nulla."
          }
        }
      }
    },
    "Your household data, encryption keys and account will be permanently deleted. This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de tu hogar, las claves de cifrado y tu cuenta se eliminarán permanentemente. No se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati della tua casa, le chiavi di cifratura e il tuo account saranno eliminati definitivamente. Non si può annullare."
          }
        }
      }
    },
    "Your message is encrypted like the rest of your household data.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mensaje se cifra como el resto de los datos de tu hogar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo messaggio è cifrato come il resto dei dati della tua casa."
          }
        }
      }
    },
    "😊 Good": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "😊 Bien"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "😊 Bene"
          }
        }
      }
    },
    "😐 Okay": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "😐 Normal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "😐 Così così"
          }
        }
      }
    },
    "🙁 Bad": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "🙁 Mal"
          }
        },
