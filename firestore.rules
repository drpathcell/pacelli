rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: Check if the caller is a member of the given household ──
    function isMember(householdId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/household_members/$(request.auth.uid + '_' + householdId));
    }

    // ── Helper: Check if authenticated ──
    function isAuth() {
      return request.auth != null;
    }

    // ── Helper: Is own document ──
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ── Helper: proof that a membership was actually authorised ──
    // `joined_via` names the household_invites or household_join_codes doc
    // that let this user in, and we verify it server-side. Without this,
    // "self-join only" still means anyone who learns a household ID can add
    // themselves to it. Ordered cheapest-first; `||` short-circuits, so the
    // common paths stay well inside the per-request document-access limit.
    function invitedByEmail(householdId, ref) {
      return exists(/databases/$(database)/documents/household_invites/$(ref))
        && get(/databases/$(database)/documents/household_invites/$(ref))
             .data.household_id == householdId
        && get(/databases/$(database)/documents/household_invites/$(ref))
             .data.invited_email == request.auth.token.email;
    }

    function holdsJoinCode(householdId, ref) {
      return exists(/databases/$(database)/documents/household_join_codes/$(ref))
        && get(/databases/$(database)/documents/household_join_codes/$(ref))
             .data.household_id == householdId
        && get(/databases/$(database)/documents/household_join_codes/$(ref))
             .data.expires_at > request.time;
    }

    function joinAuthorised(householdId) {
      // Founding: createHousehold writes the household doc and the member doc
      // in ONE batch, and rules never see a batch's own uncommitted writes —
      // so at evaluation time the household genuinely does not exist yet.
      // Once it is committed this branch is closed to everyone, and the IDs
      // are UUIDs, so it cannot be squatted ahead of time.
      return !exists(/databases/$(database)/documents/households/$(householdId))
        || (('joined_via' in request.resource.data)
            && request.resource.data.joined_via is string
            && (invitedByEmail(householdId, request.resource.data.joined_via)
                || holdsJoinCode(householdId, request.resource.data.joined_via)))
        || get(/databases/$(database)/documents/households/$(householdId))
             .data.created_by == request.auth.uid;
    }

    // ── Profiles ─────────────────────────────────────────────────
    // Any authenticated user can read profiles (needed for household
    // member display). Users can only write their own profile.
    match /profiles/{userId} {
      allow read:   if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ── Households ───────────────────────────────────────────────
    // Any authenticated user can create a household.
    // Only members can read or update.
    match /households/{householdId} {
      // created_by must be the caller: joinAuthorised()'s founder branch trusts
      // this field, so a household attributed to someone else would hand them a
      // way in.
      allow create: if isAuth() && request.resource.data.created_by == request.auth.uid;
      allow read, update: if isMember(householdId);
      allow delete: if isMember(householdId);
    }

    // ── Household Members ────────────────────────────────────────
    // Doc ID format: {userId}_{householdId}
    // Members can read their own household's members.
    // Create: allowed for authenticated users (joining via invite).
    // Delete: allowed for the member themselves (leaving).
    match /household_members/{docId} {
      allow read: if isAuth() && (
        resource.data.user_id == request.auth.uid ||
        isMember(resource.data.household_id)
      );
      // Self-join only, AND the join has to have been authorised: a bare
      // `isAuth()` here let any signed-in user mint a membership for ANYONE
      // in any household; self-only alone still let anyone who learned a
      // household ID walk in.
      allow create: if isAuth()
        && request.resource.data.user_id == request.auth.uid
        && joinAuthorised(request.resource.data.household_id);
      allow update, delete: if isAuth() && (
        resource.data.user_id == request.auth.uid ||
        isMember(resource.data.household_id)
      );
    }

    // ── Household Join Codes ─────────────────────────────────────
    // Doc ID *is* the code — a bearer secret, never stored in the body.
    // Exists because email-addressed invites match on the auth token's email,
    // which for Sign in with Apple + "Hide My Email" is a private-relay
    // address the inviter cannot know. A code works for any auth provider.
    match /household_join_codes/{code} {
      // Bearer lookup: any signed-in user may GET by exact code, and only
      // while it is live — expiry is enforced here, not just client-side.
      allow get: if isAuth() && resource.data.expires_at > request.time;
      // LIST is member-only, so codes can never be enumerated: guessing costs
      // one read per attempt against a ~39-bit space. Members can list their
      // own expired codes so the UI can offer "expired — regenerate".
      allow list: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth()
        && isMember(request.resource.data.household_id)
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.expires_at > request.time
        && request.resource.data.expires_at < request.time + duration.value(8, 'd');
      allow update, delete: if isAuth() && isMember(resource.data.household_id);
    }

    // ── Household Invites ────────────────────────────────────────
    match /household_invites/{docId} {
      allow read: if isAuth() && (
        resource.data.invited_email == request.auth.token.email ||
        isMember(resource.data.household_id)
      );
      allow create: if isAuth() && isMember(request.resource.data.household_id);
      // Household members manage the invites they issued (revoke, re-issue).
      allow update, delete: if isAuth() && isMember(resource.data.household_id);
      // Self-acceptance. checkAndAcceptInvite commits the caller's member doc
      // and this status flip in ONE batch; rules never observe a batch's own
      // uncommitted writes, so isMember() above is still false here and the
      // whole batch used to be denied (invite silently never landed).
      // Narrowest possible grant: the addressed user only, pending -> accepted,
      // status the only field that may change, single-use (no replay).
      allow update: if isAuth()
        && resource.data.invited_email == request.auth.token.email
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['status']);
    }

    // ── Household Encryption Keys ────────────────────────────────
    // Users can only read/write their own key documents.
    match /household_keys/{docId} {
      allow read: if isAuth() && resource.data.user_id == request.auth.uid;
      allow create: if isAuth() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.user_id == request.auth.uid;
    }

    // ── Tasks ────────────────────────────────────────────────────
    // Only household members can CRUD tasks in their household.
    match /tasks/{taskId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Subtasks ─────────────────────────────────────────────────
    match /subtasks/{subtaskId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Task Categories ──────────────────────────────────────────
    match /task_categories/{categoryId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Checklists ───────────────────────────────────────────────
    match /checklists/{checklistId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Checklist Items ──────────────────────────────────────────
    match /checklist_items/{itemId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Scratch Plans ────────────────────────────────────────────
    match /scratch_plans/{planId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Plan Entries ─────────────────────────────────────────────
    match /plan_entries/{entryId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Plan Checklist Items ─────────────────────────────────────
    match /plan_checklist_items/{itemId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Task Attachments ───────────────────────────────────────
    match /task_attachments/{attachmentId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Plan Attachments ────────────────────────────────────────
    match /plan_attachments/{attachmentId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Inventory Items ──────────────────────────────────────────
    match /inventory_items/{itemId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Inventory Categories ───────────────────────────────────
    match /inventory_categories/{categoryId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Inventory Locations ────────────────────────────────────
    match /inventory_locations/{locationId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Inventory Logs ─────────────────────────────────────────
    match /inventory_logs/{logId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Inventory Attachments ──────────────────────────────────
    match /inventory_attachments/{attachmentId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Manual Entries ─────────────────────────────────────────
    match /manual_entries/{entryId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Manual Categories ────────────────────────────────────
    match /manual_categories/{categoryId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Feedback ──────────────────────────────────────────────
    match /feedback/{feedbackId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Diagnostics ─────────────────────────────────────────
    match /diagnostics/{diagnosticId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Weekly Digests ──────────────────────────────────────
    match /weekly_digests/{digestId} {
      allow read: if isAuth() && isMember(resource.data.household_id);
      allow create, update: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Household Drive Config ─────────────────────────────────
    match /household_drive_config/{householdId} {
      allow read: if isMember(householdId);
      allow create, update, delete: if isMember(householdId);
    }

    // ── Default: deny everything else ────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
