rules_version = '2';

// ⚠️  DEPLOY ORDER — READ BEFORE `firebase deploy --only firestore:rules`
//
// The 2026-08-24 change to `household_members` delete (owner-or-self, was
// any-co-member) is NOT safe to deploy against the currently LIVE app.
// `BurnService` in 1.8.0 and earlier deletes every other member's row
// unconditionally, so a non-owner burning their account on the live build
// would hit permission-denied, retry three times and fail — breaking App
// Store Guideline 5.1.1(v) account deletion for exactly the people least
// likely to be the household owner.
//
// This is the 2026-08-10 mistake in a new costume: that rules deploy was
// checked against TestFlight builds 36/37 and not the build actually LIVE,
// and it locked Juan and Chloe out of accepting invitations for a day.
//
// ORDER: ship the app first, confirm READY_FOR_SALE, THEN deploy these rules.
//   1. 1.9.0 goes live with the owner-gated BurnService.wipeHousehold
//   2. `python3 scripts/asc.py status` shows 1.9.0 READY_FOR_SALE
//   3. only then: firebase deploy --only firestore:rules
//
// Everything else in this file is backwards-compatible with 1.8.0 and could
// go out today; it is held back only to keep the deploy a single event.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: Check if the caller is a member of the given household ──
    function isMember(householdId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/household_members/$(request.auth.uid + '_' + householdId));
    }

    // ── Helper: Check if authenticated ──
    function isAuth() {
      return request.auth != null;
    }

    // ── Helper: Is own document ──
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ── Helper: proof that a membership was actually authorised ──
    // `joined_via` names the household_invites or household_join_codes doc
    // that let this user in, and we verify it server-side. Without this,
    // "self-join only" still means anyone who learns a household ID can add
    // themselves to it. Ordered cheapest-first; `||` short-circuits, so the
    // common paths stay well inside the per-request document-access limit.
    function invitedByEmail(householdId, ref) {
      return exists(/databases/$(database)/documents/household_invites/$(ref))
        && get(/databases/$(database)/documents/household_invites/$(ref))
             .data.household_id == householdId
        && get(/databases/$(database)/documents/household_invites/$(ref))
             .data.invited_email == request.auth.token.email;
    }

    function holdsJoinCode(householdId, ref) {
      return exists(/databases/$(database)/documents/household_join_codes/$(ref))
        && get(/databases/$(database)/documents/household_join_codes/$(ref))
             .data.household_id == householdId
        && get(/databases/$(database)/documents/household_join_codes/$(ref))
             .data.expires_at > request.time;
    }

    function joinAuthorised(householdId) {
      // Founding: createHousehold writes the household doc and the member doc
      // in ONE batch, and rules never see a batch's own uncommitted writes —
      // so at evaluation time the household genuinely does not exist yet.
      // Once it is committed this branch is closed to everyone, and the IDs
      // are UUIDs, so it cannot be squatted ahead of time.
      // (A grace clause lived here 2026-08-10 → 2026-08-11, while the live App
      // Store build predated `joined_via`. Removed once 1.2.0/38 shipped.)
      return !exists(/databases/$(database)/documents/households/$(householdId))
        || (('joined_via' in request.resource.data)
            && request.resource.data.joined_via is string
            && (invitedByEmail(householdId, request.resource.data.joined_via)
                || holdsJoinCode(householdId, request.resource.data.joined_via)))
        || get(/databases/$(database)/documents/households/$(householdId))
             .data.created_by == request.auth.uid;
    }

    // ── Helper: household owner ──────────────────────────────────────
    // Anchored on `households.created_by`, which `create` pins to the caller
    // and `update` now freezes. The member doc's own `role` field is NOT
    // usable for this: the client writes it, so anyone holding a join code
    // could simply have set `role: 'admin'` on their own row. `create` pins
    // that too now, but created_by is the anchor because it is the field the
    // rest of this file already trusts.
    function isHouseholdOwner(householdId) {
      return isAuth()
        && exists(/databases/$(database)/documents/households/$(householdId))
        && get(/databases/$(database)/documents/households/$(householdId))
             .data.created_by == request.auth.uid;
    }

    // ── Helper: the role claimed on a membership is one the caller may claim ──
    // 'admin' is only truthful on the founding write, when the household doc
    // does not exist yet (createHousehold writes household + member in ONE
    // batch, and rules never see a batch's own uncommitted writes). Every
    // other join is a 'member'. The assistant role is written by a Cloud
    // Function via the admin SDK, which bypasses rules entirely, so pinning
    // this does not touch AI linking.
    function roleOnCreateIsHonest(householdId) {
      return !('role' in request.resource.data)
        || request.resource.data.role == 'member'
        || (request.resource.data.role == 'admin' && ownerOrUnborn(householdId));
    }

    // 'admin' is truthful in exactly two places: the founding write, when the
    // household doc is not committed yet, and the founder's own recovery write
    // when their member doc was lost but the household is provably theirs.
    // Two document accesses, and only on the rare 'admin' branch — the common
    // join path never reaches this.
    function ownerOrUnborn(householdId) {
      return !exists(/databases/$(database)/documents/households/$(householdId))
        || get(/databases/$(database)/documents/households/$(householdId))
             .data.created_by == request.auth.uid;
    }

    // ── Profiles ─────────────────────────────────────────────────
    // Any authenticated user can read profiles (needed for household
    // member display). Users can only write their own profile.
    match /profiles/{userId} {
      allow read:   if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ── Households ───────────────────────────────────────────────
    // Any authenticated user can create a household.
    // Only members can read or update.
    match /households/{householdId} {
      // created_by must be the caller: joinAuthorised()'s founder branch trusts
      // this field, so a household attributed to someone else would hand them a
      // way in.
      allow create: if isAuth() && request.resource.data.created_by == request.auth.uid;
      allow read: if isMember(householdId);
      // created_by is FROZEN after creation. Both joinAuthorised()'s founder
      // branch and isHouseholdOwner() trust this field, so a member able to
      // rewrite it could promote themselves to owner and then remove everyone
      // else — and since 1.7.0 an AI assistant is a member like any other.
      // Rename uses updateData(["name": ...]), which carries the existing
      // created_by through untouched, so this costs the app nothing.
      allow update: if isMember(householdId)
        && request.resource.data.created_by == resource.data.created_by;
      allow delete: if isMember(householdId);
    }

    // ── Household Members ────────────────────────────────────────
    // Doc ID format: {userId}_{householdId}
    // Members can read their own household's members.
    // Create: allowed for authenticated users (joining via invite).
    // Delete: allowed for the member themselves (leaving).
    match /household_members/{docId} {
      allow read: if isAuth() && (
        resource.data.user_id == request.auth.uid ||
        isMember(resource.data.household_id)
      );
      // Self-join only, AND the join has to have been authorised: a bare
      // `isAuth()` here let any signed-in user mint a membership for ANYONE
      // in any household; self-only alone still let anyone who learned a
      // household ID walk in.
      allow create: if isAuth()
        && request.resource.data.user_id == request.auth.uid
        && joinAuthorised(request.resource.data.household_id)
        && roleOnCreateIsHonest(request.resource.data.household_id);
      // Nothing in the app has ever UPDATED a member doc — the write path is
      // create-then-delete. Self-only, with identity and role frozen, keeps
      // that from being a door an assistant can walk through later.
      allow update: if isAuth()
        && resource != null
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.household_id == resource.data.household_id
        && request.resource.data.role == resource.data.role;
      // Leaving is yours; removing OTHER PEOPLE is the owner's. Until now any
      // member could delete any member, which after 1.7.0 meant a paired AI
      // assistant could evict the household's own people.
      // The self branch stays first and unconditional: burn's orphan sweep
      // deletes legacy member docs with no household_id at all, and
      // isHouseholdOwner() cannot be asked about a household that is not named.
      allow delete: if isAuth() && (
        resource.data.user_id == request.auth.uid ||
        (('household_id' in resource.data)
         && isHouseholdOwner(resource.data.household_id))
      );
    }

    // ── Household Join Codes ─────────────────────────────────────
    // Doc ID *is* the code — a bearer secret, never stored in the body.
    // Exists because email-addressed invites match on the auth token's email,
    // which for Sign in with Apple + "Hide My Email" is a private-relay
    // address the inviter cannot know. A code works for any auth provider.
    match /household_join_codes/{code} {
      // Bearer lookup: any signed-in user may GET by exact code, and only
      // while it is live — expiry is enforced here, not just client-side.
      allow get: if isAuth() && resource.data.expires_at > request.time;
      // LIST is member-only, so codes can never be enumerated: guessing costs
      // one read per attempt against a ~39-bit space. Members can list their
      // own expired codes so the UI can offer "expired — regenerate".
      allow list: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth()
        && isMember(request.resource.data.household_id)
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.expires_at > request.time
        && request.resource.data.expires_at < request.time + duration.value(8, 'd');
      allow update, delete: if isAuth() && isMember(resource.data.household_id);
    }

    // ── Household Invites ────────────────────────────────────────
    match /household_invites/{docId} {
      allow read: if isAuth() && (
        resource.data.invited_email == request.auth.token.email ||
        isMember(resource.data.household_id)
      );
      allow create: if isAuth() && isMember(request.resource.data.household_id);
      // Household members manage the invites they issued (revoke, re-issue).
      allow update, delete: if isAuth() && isMember(resource.data.household_id);
      // Self-acceptance. checkAndAcceptInvite commits the caller's member doc
      // and this status flip in ONE batch; rules never observe a batch's own
      // uncommitted writes, so isMember() above is still false here and the
      // whole batch used to be denied (invite silently never landed).
      // Narrowest possible grant: the addressed user only, pending -> accepted,
      // status the only field that may change, single-use (no replay).
      allow update: if isAuth()
        && resource.data.invited_email == request.auth.token.email
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['status']);
    }

    // ── Household Encryption Keys ────────────────────────────────
    // Users can only read/write their own key documents.
    match /household_keys/{docId} {
      allow read: if isAuth() && resource.data.user_id == request.auth.uid;
      allow create: if isAuth() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.user_id == request.auth.uid;
    }

    // ── Tasks ────────────────────────────────────────────────────
    // Only household members can CRUD tasks in their household.
    match /tasks/{taskId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Subtasks ─────────────────────────────────────────────────
    match /subtasks/{subtaskId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Task Categories ──────────────────────────────────────────
    match /task_categories/{categoryId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Checklists ───────────────────────────────────────────────
    match /checklists/{checklistId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Checklist Items ──────────────────────────────────────────
    match /checklist_items/{itemId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Checklist Templates ──────────────────────────────────────
    // A reusable set of items ("quick Dunnes shop") any member can stamp into
    // a real checklist. Same household gate as checklists — the items live
    // inside the doc as one encrypted blob rather than in their own
    // collection, so there is nothing else to guard.
    match /checklist_templates/{templateId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Scratch Plans ────────────────────────────────────────────
    match /scratch_plans/{planId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Plan Entries ─────────────────────────────────────────────
    match /plan_entries/{entryId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Plan Checklist Items ─────────────────────────────────────
    match /plan_checklist_items/{itemId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Task Attachments ───────────────────────────────────────
    match /task_attachments/{attachmentId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Plan Attachments ────────────────────────────────────────
    match /plan_attachments/{attachmentId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Inventory Items ──────────────────────────────────────────
    match /inventory_items/{itemId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Inventory Categories ───────────────────────────────────
    match /inventory_categories/{categoryId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Inventory Locations ────────────────────────────────────
    match /inventory_locations/{locationId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Inventory Logs ─────────────────────────────────────────
    match /inventory_logs/{logId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Inventory Attachments ──────────────────────────────────
    match /inventory_attachments/{attachmentId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Manual Entries ─────────────────────────────────────────
    match /manual_entries/{entryId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Manual Categories ────────────────────────────────────
    match /manual_categories/{categoryId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Device tokens (push) ──────────────────────────────────
    match /device_tokens/{token} {
      // The doc id IS the FCM token. Self-only in both directions: a token
      // row says "send this household's activity to this device", so being
      // able to enumerate or write someone else's is the whole attack.
      allow get, list: if isAuth() && resource.data.user_id == request.auth.uid;

      // isMember is the load-bearing clause. Without it any signed-in user
      // could register their own device against someone else's household_id
      // and be pushed that household's activity — the one way push can leak
      // what the encryption otherwise protects.
      allow create: if isAuth()
        && request.resource.data.user_id == request.auth.uid
        && isMember(request.resource.data.household_id)
        && request.resource.data.keys().hasOnly([
             'token', 'user_id', 'household_id', 'platform',
             'app_version', 'activity_push', 'updated_at']);

      // Both sides checked: the row must already be theirs AND stay theirs.
      // Checking only request.resource would let someone who learned another
      // device's token overwrite the row and silently take over its pushes.
      allow update: if isAuth()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && isMember(request.resource.data.household_id)
        && request.resource.data.keys().hasOnly([
             'token', 'user_id', 'household_id', 'platform',
             'app_version', 'activity_push', 'updated_at']);

      // Sign-out and burn both delete while still authenticated — see
      // PushService.unregister(). A token that outlives its session keeps
      // pushing a household's activity to a phone that has left it.
      allow delete: if isAuth() && resource.data.user_id == request.auth.uid;
    }

    // ── Feedback ──────────────────────────────────────────────
    match /feedback/{feedbackId} {
      // Create is NOT tied to household membership. Feedback is the one thing
      // a stranger sends TO us, and requiring isMember() made a fresh
      // install's ability to report a bug depend on household state that may
      // not have settled yet. created_by is pinned instead, so entries stay
      // attributable and nobody can write one in someone else's name.
      allow create: if isAuth()
        && request.resource.data.created_by == request.auth.uid
        // Shape-pinned. Dropping isMember() opened this to every signed-in
        // user on the internet, so the document itself has to be constrained:
        // exact field set, known enum values, and a size cap well under the
        // 1 MB document limit so nobody can park megabytes here for free.
        && request.resource.data.keys().hasOnly([
             'id', 'household_id', 'type', 'rating',
             'message', 'context', 'created_by', 'created_at'])
        && request.resource.data.type in ['general', 'bug', 'featureRequest']
        && request.resource.data.rating in ['positive', 'neutral', 'negative']
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 100000;
        // Deliberately NOT requiring the 'pfb1:' sealed prefix. The version
        // live on the App Store today (1.2.0) still writes household-key
        // ciphertext, and rejecting it here would break "send feedback" for
        // every user on the current build the moment this deploys. Add the
        // prefix check once the sealed build has actually rolled out.

      // Immutable once sent: a submitted report cannot be rewritten.
      allow update: if false;

      // Read and delete stay keyed to household membership — deliberately NOT
      // narrowed to created_by. Burn-all-data and discardOwnEmptyHouseholds
      // both sweep every content collection with a `household_id ==` query,
      // so a created_by-scoped rule would deny those queries and break burn
      // outright. The exposure it would buy back is worth nothing anyway: the
      // message is sealed to the Pacelli public key, so a household member
      // fetching it gets ciphertext they hold no key for.
      //
      // Retrieval for us is scripts/read_feedback.py, which uses Admin
      // credentials and bypasses rules entirely.
      allow read, delete: if isAuth() && isMember(resource.data.household_id);
    }

    // ── Diagnostics ─────────────────────────────────────────
    match /diagnostics/{diagnosticId} {
      allow read, update, delete: if isAuth() && isMember(resource.data.household_id);
      allow create: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Weekly Digests ──────────────────────────────────────
    match /weekly_digests/{digestId} {
      allow read: if isAuth() && isMember(resource.data.household_id);
      allow create, update: if isAuth() && isMember(request.resource.data.household_id);
    }

    // ── Household Drive Config ─────────────────────────────────
    match /household_drive_config/{householdId} {
      allow read: if isMember(householdId);
      allow create, update, delete: if isMember(householdId);
    }

    // ── AI pairing codes ─────────────────────────────────────────
    // NO client access, ever. A code is a bearer credential: anyone who reads
    // one can redeem it for an assistant session on that household. Only the
    // Cloud Functions touch this collection, and they use the Admin SDK, which
    // bypasses rules — so this block exists to say "deliberately unreachable"
    // rather than to grant anything. The catch-all below would deny it anyway;
    // being explicit means a future reader does not have to infer the intent.
    // ── Photos ───────────────────────────────────────────────────
    // The document is the small half of a photo: metadata, an encrypted
    // thumbnail of a few kilobytes, and the encrypted text Vision read on the
    // device. The image itself is an object in Cloud Storage that no client
    // can reach — see storage.rules and functions/src/functions/photos.ts.
    //
    // Deleting one of these documents deletes the object with it, via the
    // onPhotoDeleted trigger. That is what keeps burn-all-data correct without
    // burn needing to know Cloud Storage exists.
    match /photos/{photoId} {
      allow read: if isMember(resource.data.household_id);
      allow create: if isMember(request.resource.data.household_id)
        && request.resource.data.created_by == request.auth.uid;
      allow update, delete: if isMember(resource.data.household_id);
    }

    match /ai_link_codes/{code} {
      allow read, write: if false;
    }

    // ── Default: deny everything else ────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
