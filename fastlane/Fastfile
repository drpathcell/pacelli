default_platform(:ios)

# ─── Shared helpers ────────────────────────────────────────────────────────────

def asc_api_key
  app_store_connect_api_key(
    key_id:        ENV["ASC_KEY_ID"],
    issuer_id:     ENV["ASC_ISSUER_ID"],
    key_content:   ENV["ASC_KEY_CONTENT"],   # .p8 content, not file path
    is_key_content_base64: true,
    in_house:      false
  )
end

# ─── iOS ───────────────────────────────────────────────────────────────────────

platform :ios do

  desc "Sync certificates and provisioning profiles (read-only by default)"
  # NOTE: this lane SHADOWS fastlane's built-in `sync_signing` action. Calling
  # sync_signing(...) anywhere in this file reaches here, not match. That cost
  # a green CI run on 2026-08-11 that created nothing: app_identifier was
  # hardcoded to the app alone, so the notification extension was never synced,
  # and the job "succeeded" because it did succeed at what it actually did.
  ALL_APP_IDENTIFIERS = [
    "com.pacelli.pacelli",
    "com.pacelli.pacelli.NotificationService"
  ].freeze

  lane :sync_signing do |options|
    api_key = asc_api_key
    match(
      type:               options[:type] || "appstore",
      readonly:           options.fetch(:readonly, true),
      api_key:            api_key,
      app_identifier:     options[:app_identifier] || ALL_APP_IDENTIFIERS
    )
  end

  desc "Create any missing App Store profiles (CI only — needs a writable match repo)"
  lane :sync_appstore_signing do
    # appstore ONLY, deliberately. `regenerate_signing` also syncs the
    # development type, which would mint a development certificate we do not
    # need; there are already 2 distribution certs against Apple's limit of 3,
    # and burning a slot to create a profile would be a poor trade. readonly is
    # false so match CREATES the missing extension profile, but nothing is
    # forced — an existing valid cert is reused, never revoked.
    sync_signing(type: "appstore", readonly: false)
  end

  desc "Regenerate certs/profiles (CI: set readonly=false + MATCH_GIT_URL writable)"
  lane :regenerate_signing do
    sync_signing(type: "appstore",     readonly: false)
    sync_signing(type: "development",  readonly: false)
  end

  # ─── Native SwiftUI app (PacelliApp/) — rewrite, 2026-07-07 ─────────────────
  # These lanes ship the native app on the SAME ASC record (version 1.0.0, builds ≥ 26).

  desc "Build the native app as a signed IPA (match)"
  lane :native_build do
    api_key = asc_api_key
    sync_signing(type: "appstore", readonly: true)

    # The floor. project.yml carries the same number so that local and
    # simulator builds agree with CI; the assertion below stops the two from
    # drifting into a project.yml that quietly means nothing.
    native_floor = 35

    spec = File.read("../PacelliApp/project.yml")
    spec_floors = spec.scan(/CURRENT_PROJECT_VERSION:\s*"(\d+)"/).flatten.uniq
    unless spec_floors == [native_floor.to_s]
      UI.user_error!(
        "project.yml CURRENT_PROJECT_VERSION #{spec_floors.inspect} does not " \
        "match the native_build floor #{native_floor}. They must be equal — " \
        "the value is a floor for local builds, not a build number."
      )
    end

    # Collision-proof build number (same lesson as the retired Flutter lane).
    # No version filter: build numbers are globally ascending across
    # versions (1.0.0 shipped builds 26-34 → 1.1.0 floor is 35), so query
    # the app-wide TestFlight max, not one version train's.
    latest_tf = (latest_testflight_build_number(
      api_key:        api_key,
      app_identifier: "com.pacelli.pacelli"
    ) rescue 0)
    build_number = [native_floor, latest_tf.to_i + 1].max
    UI.message("Native build number: floor=#{native_floor} latest_testflight=#{latest_tf} -> using #{build_number}")

    # project.yml is the source of truth — regenerate the .xcodeproj.
    sh("cd ../PacelliApp && xcodegen generate")

    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "PacelliApp/PacelliApp.xcodeproj",
      bundle_identifier:     "com.pacelli.pacelli",
      team_id:               "5PCNU95W9V",
      code_sign_identity:    "Apple Distribution",
      profile_name:          "match AppStore com.pacelli.pacelli",
      targets:               ["PacelliApp"]
    )

    # The notification extension signs separately — an app extension is its own
    # bundle id and cannot ride the containing app's profile. Miss this and the
    # archive fails at export, not at build, which is a slow way to find out.
    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "PacelliApp/PacelliApp.xcodeproj",
      bundle_identifier:     "com.pacelli.pacelli.NotificationService",
      team_id:               "5PCNU95W9V",
      code_sign_identity:    "Apple Distribution",
      profile_name:          "match AppStore com.pacelli.pacelli.NotificationService",
      targets:               ["PacelliNotificationService"]
    )

    build_app(
      project:          "PacelliApp/PacelliApp.xcodeproj",
      scheme:           "PacelliApp",
      configuration:    "Release",
      output_directory: "build/native",
      output_name:      "Pacelli.ipa",
      export_method:    "app-store",
      xcargs:           "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options:   {
        provisioningProfiles: {
          "com.pacelli.pacelli" => "match AppStore com.pacelli.pacelli",
          "com.pacelli.pacelli.NotificationService" =>
            "match AppStore com.pacelli.pacelli.NotificationService"
        }
      }
    )
  end

  desc "Native build + upload to TestFlight"
  lane :native_beta do
    api_key = asc_api_key
    native_build
    upload_to_testflight(
      api_key:                           api_key,
      skip_waiting_for_build_processing: true,
      distribute_external:               false,
      notify_external_testers:           false,
      changelog: "Native SwiftUI rewrite — walking skeleton: guest-first onboarding, tasks (E2E-verified on simulator)"
    )
  end

end
